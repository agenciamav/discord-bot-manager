# Configurações do Bot Discord
TOKEN=seu_token_bot_discord
CLIENT_ID=id_da_aplicacao_discord 
GUILD_ID=id_do_servidor_discord

# Configurações da API
APP_URL=https://app.agenciamav.local
# APP_URL=http://localhost:8000
API_TOKEN=
# PORT=8080

# Segurança
BOT_MANAGER_SECRET=chave_secreta_do_bot_manager

# Conexão com API alternativa
API_IP=
API_PORT=

# Configurações para integração com IA de voz
# AssemblyAI (Speech-to-Text)
ASSEMBLY_AI_API_KEY=sua_chave_assemblyai

# OpenAI (IA para respostas)
OPENAI_API_KEY=sua_chave_openai

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=sua_chave_elevenlabs
ELEVENLABS_VOICE_ID=id_da_voz_elevenlabs